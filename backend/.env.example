# Create a Google OAuth 2.0 Web application client and enable the Gmail API.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
# Register this exact localhost URI on the Google OAuth Web application client.
# Start Gmail connection from a browser on the Docker host (http://localhost:8000).
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/gmail/oauth/callback
# Return to the app served by the container on the Docker host.
GMAIL_APP_RETURN_URL=http://localhost:8000/
# Generate a Fernet key; keep it stable so the saved token remains decryptable.
GMAIL_TOKEN_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
