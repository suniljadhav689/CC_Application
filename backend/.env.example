# Create a Google OAuth 2.0 Web application client and enable the Gmail API.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
# Register this exact localhost URI on your Google OAuth Web application client.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/gmail/oauth/callback
# The OAuth callback returns the laptop browser to this frontend URL.
GMAIL_APP_RETURN_URL=http://localhost:5174/
# Generate with: backend/.venv/Scripts/python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GMAIL_TOKEN_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
